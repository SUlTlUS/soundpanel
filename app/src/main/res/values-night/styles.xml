<resources>
    <color name="app_window_background">#000000</color>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorBackground">@color/app_window_background</item>
        <item name="android:windowBackground">@color/app_window_background</item>
        <item name="android:windowSplashScreenBackground">@color/app_window_background</item>
        <item name="android:colorAccent">#2985FF</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
